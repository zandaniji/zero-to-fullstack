# Copy this file to ".env" and change the values. Never commit .env to git!

PORT=3000

# A long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# The address of the React app (allowed by CORS)
CLIENT_ORIGIN=http://localhost:5173

# Where the SQLite database file lives
DB_FILE=tasks.db
